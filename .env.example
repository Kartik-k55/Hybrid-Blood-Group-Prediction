# AES-256-GCM Encryption Key
# IMPORTANT: Never commit your actual .env file or hard-code encryption keys in code!
# The key must be a cryptographically secure 256-bit (32-byte) key.
# 
# Formats accepted:
# 1. 64-character Hexadecimal string (recommended)
# 2. 44-character Base64-encoded string
# 3. 32-character raw ASCII string
#
# To generate a new random 256-bit AES key, run:
#   python -c "import encryption; print(encryption.generate_key())"
#
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
